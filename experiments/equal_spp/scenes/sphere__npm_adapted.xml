<scene version="2.0.0">

    <default name="light_angle" value="60"/>

    <default name="spp" value="60"/>
    <default name="crop_offset_x" value="0"/>
    <default name="crop_offset_y" value="0"/>
    <default name="crop_width" value="64"/>
    <default name="crop_height" value="64"/>

    <default name="samples_per_pass" value="1"/>   <!-- == ((size_t) -1) -->
    <default name="timeout" value="0"/>

    <default name="caustics_biased"                 value="false"/>
    <default name="caustics_twostage"               value="false"/>
    <default name="caustics_halfvector_constraints" value="false"/>
    <default name="caustics_mnee_init"              value="false"/>

    <default name="caustics_max_iterations"         value="20"/>
    <default name="caustics_solver_threshold"       value="0.00001"/>
    <default name="caustics_uniqueness_threshold"   value="0.00001"/>
    <default name="caustics_max_trials"             value="10000000"/>

    <default name="biased_mnee" value="false"/>

    <integrator type="manifold_path_guiding">
		<integer name="max_depth" value="6" />
		<integer name="samples_per_pass" value="1" />
		<boolean name="selective" value="false" />
		<boolean name="budget_is_time" value="false" />
		<float name="timeout" value="0" />
		<integer name="seedid" value="1668592294" />
		<float name="bounce_alpha" value="1.0" />
		<boolean name="train_auto" value="false" />
		<boolean name="guided" value="false" />
		<float name="learned_proposal_inv_prob_clamp" value="512.0" />
		<float name="learned_proposal_contribution_clamp" value="32.0" />
		<integer name="max_trials" value="2048" />
		<integer name="diffusion_steps" value="10" />
		<float name="learned_direction_kappa_scale" value="1.0" />
		<boolean name="learned_direction_flip_to_receiver_hemisphere" value="false" />
		<string name="masked_diffusion_runtime_path" value="${MODEL_EXPORT}" />
	</integrator>

    <sensor type="perspective">
        <string name="fov_axis" value="smaller"/>
        <float name="near_clip" value="0.0001"/>
        <float name="far_clip" value="1000000"/>
        <float name="fov" value="48"/>
        <transform name="to_world">
        <lookat origin="10, 11, 10"
                    target="0, 0.5, 0"
                    up    ="0, 1, 0"/>
        </transform>
        <sampler type="independent">
            <integer name="seed" value="1668592294" />
            <integer name="sample_count" value="60"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width" value="64"/>
            <integer name="height" value="64"/>
            <rfilter type="gaussian"/>

            <integer name="crop_offset_x" value="0"/>
            <integer name="crop_offset_y" value="0"/>
            <integer name="crop_width" value="64"/>
            <integer name="crop_height" value="64"/>
        </film>
    </sensor>

    <shape type="rectangle">
        <bsdf type="diffuse" id="light">
            <spectrum name="reflectance" value="0.0"/>
        </bsdf>

        <emitter type="area">
            <boolean name="caustic_emitter_single" value="true"/>
            <spectrum name="radiance" value="50000"/>
        </emitter>

        <transform name="to_world">
            <rotate x="1" y="0" z="0" angle="90"/>
            <scale x="0.2" y="1" z="0.2"/>
            <translate x="0" y="50" z="0"/>

            <rotate x="1" y="0" z="0" angle="$light_angle"/>
            <rotate x="0" y="1" z="0" angle="90"/>
        </transform>
    </shape>

    <shape type="rectangle">
        <boolean name="caustic_receiver" value="true"/>

        <bsdf type="diffuse">
            <spectrum name="reflectance" type="bitmap">
                <string name="filename" value="${ARTMPG_ROOT}/512diffusion/scenes/sphere/textures/[2K]Tiles71/Tiles71_col.jpg"/>
                <transform name="to_uv">
                    <scale x="50" y="50"/>
                </transform>
            </spectrum>
        </bsdf>

        <transform name="to_world">
            <scale x="400" y="400" z="400"/>
            <rotate x="1" y="0" z="0" angle="-90"/>
        </transform>
    </shape>

    <shape type="sphere">
        <boolean name="caustic_caster_single" value="true"/>

        <bsdf type="normalmap">
            <bsdf type="dielectric"/>
            <string name="filename" value="${ARTMPG_ROOT}/512diffusion/scenes/sphere/textures/normalmap_waves.exr"/>
            <float name="tiles" value="1"/>
        </bsdf>

        <transform name="to_world">
            <scale x="6.5" y="6.5" z="6.5"/>
        </transform>
    </shape>
</scene>
